# Copy to .env.local and fill in. Never commit real keys.
VITE_GROQ_API_KEY=
VITE_GOOGLE_API_KEY=
VITE_MISTRAL_API_KEY=
VITE_HF_API_TOKEN=
VITE_GROQ_MODEL=openai/gpt-oss-120b
VITE_GEMINI_MODEL=gemini-flash-latest
VITE_MISTRAL_MODEL=mistral-small-latest
# Backend: run `npm run server` and set this to /api (proxied by Vite to localhost:8000).
# Empty = mock API with synthetic data in the browser. With the backend, put AI keys in server/.env instead.
VITE_API_BASE_URL=
