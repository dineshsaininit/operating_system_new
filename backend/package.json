{
  "name": "aasiom-command-os-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AASIOM COMMAND OS — backend API implementing BACKEND_API_CONTRACT.md (synthetic data only until Gate 0).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/reseed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/node": "22.10.1",
    "typescript": "5.6.2"
  }
}
