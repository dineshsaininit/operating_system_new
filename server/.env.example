# Copy to server/.env. All values are optional.
PORT=8000
# DATA_DIR=data
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to false for anything beyond a local synthetic demo (disables POST /api/demo/reset)
DEMO_MODE=true
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# AI gateway — keys live ONLY here, never in VITE_* variables
GROQ_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
MISTRAL_MODEL=mistral-small-latest
